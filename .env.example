# ============================================
# Bitrix24 Application
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

CLIENT_ID=bitrix_application_client_id
CLIENT_SECRET=bitrix_application_client_secret
SCOPE=crm,user_brief,pull,placement,userfieldconfig

# ============================================
# PostgreSQL
# ============================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppass

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_USER=queue_user
RABBITMQ_PASSWORD=queue_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# S3 (MinIO for local development)
# ============================================
S3_ENDPOINT=localhost
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app-bucket
S3_USE_SSL=false

# ============================================
# Application
# ============================================
PORT=8000
NODE_ENV=development
