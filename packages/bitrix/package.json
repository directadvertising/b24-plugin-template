{
  "name": "@common/bitrix",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --fix ."
  },
  "peerDependencies": {
    "react": "19.2.0",
    "jotai": "2",
    "@bitrix24/b24jssdk": "0.5"
  },
  "devDependencies": {
    "@bitrix24/b24jssdk": "0.5",
    "@types/react": "19.2.7",
    "jotai": "2",
    "react": "19.2.0",
    "tsdown": "0.20.3",
    "typescript": "5.9.3"
  }
}
